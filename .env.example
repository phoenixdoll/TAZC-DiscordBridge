# Copy this file to .env and fill in real values. Never commit the real .env.

# Discord bot token, from the Bot tab of your application at
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# The Discord channel ID that bridges to 100MHz. Right-click the channel in
# Discord (Developer Mode must be on in Discord settings) -> Copy Channel ID.
DISCORD_CHANNEL_ID=

# SFTP connection details for the machine running your TAZC server.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
# Prefer a private key over a password. Leave SFTP_PASSWORD blank if using
# SFTP_KEY_PATH.
SFTP_KEY_PATH=
SFTP_PASSWORD=

# Absolute path, ON THE SERVER, to the Zomboid data folder for this server
# instance -- the folder that contains Lua/, Saves/, Server/, etc. Ask your
# host if you're not sure; with Indifferent Broccoli this is usually shown
# in the file manager/SFTP panel already. Do NOT include a trailing slash.
ZOMBOID_DATA_PATH=/home/pzserver/Zomboid

# Must match TAZC_Config.MaxMessageLength on your server (Sandbox Options ->
# Terror AustraliZ Chat -> Max Message Length). Default 500.
MAX_MESSAGE_LENGTH=500

# How often (seconds) to poll the outbox file for new radio transmissions.
POLL_INTERVAL_SECONDS=3
