# Copy this file to .env and fill in real values. Never commit the real .env.

# Discord bot token, from the Bot tab of your application at
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# The Discord channel ID that bridges to 100MHz. Right-click the channel in
# Discord (Developer Mode must be on in Discord settings) -> Copy Channel ID.
DISCORD_CHANNEL_ID=

# SFTP connection details for the machine running your TAZC server.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
# Prefer a private key over a password. Leave SFTP_PASSWORD blank if using
# SFTP_KEY_PATH.
SFTP_KEY_PATH=
SFTP_PASSWORD=

# Absolute path, ON THE SERVER, to the Zomboid data folder for this server
# instance -- the folder that contains Lua/, Saves/, Server/, etc. Ask your
# host if you're not sure; with Indifferent Broccoli this is usually shown
# in the file manager/SFTP panel already. Do NOT include a trailing slash.
ZOMBOID_DATA_PATH=/home/pzserver/Zomboid

# Per-CHUNK size for Discord -> game only. A Discord message longer than
# this is split into multiple chunks this long (breaking on whitespace
# where possible, hard-cut if a single "word" has no spaces) rather than
# rejected -- each chunk goes out as its own radio transmission. Independent
# of the game's own TAZC_Config.MaxMessageLength sandbox setting (which
# governs game -> Discord, sent as one message, no splitting) -- just make
# sure this value does not EXCEED that sandbox setting, or the Lua side
# will discard chunks that are still too long for it.
MAX_MESSAGE_LENGTH=500

# How often (seconds) to poll the outbox file for new radio transmissions.
POLL_INTERVAL_SECONDS=3

# Optional character-name enforcement: before relaying a 100MHz post,
# checks that the poster's Discord nickname contains their approved
# character's name (case-insensitive), unless they hold one of
# NAME_CHECK_BYPASS_ROLE_IDS. A mismatch deletes the message and DMs the
# author why (falling back to a channel notice pinging SENIOR_STAFF_ROLE_ID
# if their DMs are closed). Leave CHARACTERS_FILE_PATH blank to disable
# this entirely -- every message relays unconditionally, same as before.
#
# CHARACTERS_FILE_PATH must point at WhitelistManager's characters.json --
# written by its /approvecharacter command. Only works when both bots run
# on the same machine (plain local file read, not SFTP) -- e.g.
# /home/ubuntu/whitelist-manager/characters.json on the shared VPS.
CHARACTERS_FILE_PATH=
NAME_CHECK_BYPASS_ROLE_IDS=
SENIOR_STAFF_ROLE_ID=

# Fallback for accounts characters.json doesn't have an entry for (or
# whose entry doesn't match): WhitelistManager's accounts.json (Discord ID
# -> PZ login username, set only by staff running /whitelist) plus the
# live status.txt snapshot (same file /players reads, same ZOMBOID_DATA_PATH
# as the outbox/inbox files above) tells us that account's CURRENT in-game
# character name. Same same-machine plain-file-read requirement as
# CHARACTERS_FILE_PATH. Leave blank to skip this fallback entirely (a
# characters.json miss just fails outright, same as before this existed).
ACCOUNTS_FILE_PATH=

# Safety switch for rolling out the whole character-name check: while
# false (the default), every check above still runs and logs its verdict
# (see check_character_name / on_message), but never deletes a message or
# blocks anyone -- everything relays exactly as if this feature didn't
# exist. Only set to true after reviewing a few days of those logs
# (journalctl -u tazc-bridge) and confirming the false-positive rate is
# acceptable -- in particular for accounts whose Discord name has
# characters PZ's own username sanitizer mangles.
NAME_CHECK_ENFORCE=false
